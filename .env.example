# Copia este archivo como .env para cambiar los valores por defecto de docker-compose.yml.
# .env esta en .gitignore: nunca subas secretos reales al repositorio.

DB_NAME=identitydb
DB_USERNAME=identity
DB_PASSWORD=identity
DB_HOST_PORT=5433

IDENTITY_HOST_PORT=8081

# Minimo 32 caracteres. Debe ser el mismo que use el API Gateway para validar tokens.
JWT_SECRET=local-dev-only-secret-change-me-in-any-shared-env
JWT_EXPIRATION_MINUTES=60

# true solo en desarrollo.
EXPOSE_VERIFICATION_TOKEN=true

ADMIN_EMAIL=admin@peaceapp.pe
ADMIN_PASSWORD=Admin12345
